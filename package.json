{
  "name": "stockbook",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "npm run db:start --workspace server",
    "seed:demo": "npm run seed:demo --workspace server",
    "seed:workflow": "npm run seed:workflow --workspace server",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10"
  }
}
